<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your <%= appName %> verification code</title>
    <style>
      body { margin: 0; padding: 0; background-color: #f4f6f8; font-family: Arial, Helvetica, sans-serif; color: #17202a; }
      .wrapper { padding: 32px 16px; }
      .card { max-width: 560px; margin: 0 auto; background: #ffffff; border: 1px solid #e3e8ee; border-radius: 12px; padding: 32px; }
      .brand { margin: 0 0 24px; font-size: 20px; font-weight: 700; color: #0f766e; }
      h1 { margin: 0 0 16px; font-size: 24px; line-height: 1.3; }
      p { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #4b5563; }
      .code { margin: 24px 0; padding: 16px; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 8px; font-size: 32px; font-weight: 700; letter-spacing: 6px; text-align: center; color: #115e59; }
      .button { display: inline-block; margin: 8px 0 24px; padding: 12px 20px; background: #0f766e; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 700; }
      .footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e5e7eb; font-size: 13px; color: #6b7280; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <p class="brand"><%= appName %></p>
        <h1>Verify your email</h1>
        <p>Use this verification code to finish setting up your <%= appName %> account:</p>
        <div class="code"><%= otp %></div>
        <% if (typeof expiresInMinutes === 'number') { %>
          <p>This code expires in <%= expiresInMinutes %> minutes.</p>
        <% } else { %>
          <p>This code expires shortly. If it has expired, request a new one.</p>
        <% } %>
        <p>If you did not request this code, you can safely ignore this email.</p>
        <a class="button" href="<%= clientUrl %>">Open <%= appName %></a>
        <p class="footer">&copy; <%= currentYear %> <%= appName %>. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
