# Server
PORT=3000
NODE_ENV=development

# MongoDB (Atlas replica set required for transactions)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/earnbridge?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ACCESS_TOKEN_COOKIE_NAME=eb_access_token
REFRESH_TOKEN_COOKIE_NAME=eb_refresh_token

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Arcjet (Security & Rate Limiting)
ARCJET_KEY=your-arcjet-key
ARCJET_ENV=development

# ayeT-Studios Offerwall & Rewarded Video
# Offerwall adslot ID (Website placement, Offerwall adslot)
AYET_ADSLOT_ID=your-ayet-adslot-id
# Rewarded Video adslot ID (Website placement, Rewarded Video adslot)
AYET_REWARDED_VIDEO_ADSLOT_ID=your-ayet-rewarded-video-adslot-id
# Publisher API key used to verify the X-Ayetstudios-Security-Hash HMAC
AYET_CALLBACK_SECRET=your-ayet-publisher-api-key
# Optional comma-separated IP allowlist for /v1/callbacks/ayet
AYET_CALLBACK_IP_WHITELIST=

# Rewards & Wallet
REWARD_SHARE_BPS=7000
CURRENCY_CODE=USD
MIN_WITHDRAWAL_AMOUNT=1000
MAX_WITHDRAWAL_AMOUNT=100000
WITHDRAWAL_HOLD_DAYS=7

# AI Chat (OpenAI Responses API, stage 1 support chat)
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4.1-mini

# CORS
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173,https://earnbridge-liart.vercel.app

# Email provider: 'smtp' (Nodemailer) or 'brevo' (Brevo REST API)
EMAIL_PROVIDER=smtp
# Required only when EMAIL_PROVIDER=brevo. Get a key at https://app.brevo.com
BREVO_API_KEY=
# Absolute URL of the logo shown in emails. The API serves it at
# /email-assets/earnbridge-logo.png, e.g. https://your-api.example.com/email-assets/earnbridge-logo.png
EMAIL_LOGO_URL=
# SMTP settings (used when EMAIL_PROVIDER=smtp)
# Use a Google App Password for EMAIL_PASSWORD, not your normal Gmail password.
# Google displays app passwords in groups; use the 16-character code without spaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=your-gmail-address@gmail.com
# Optional sender display name. Defaults to EMAIL_APP_NAME when empty.
EMAIL_FROM_NAME=EarnBridge
EMAIL_APP_NAME=EarnBridge
CLIENT_URL=http://localhost:5173

# Sentry (before launch)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=info

# Trust proxy hops (Railway/Render = 1)
TRUST_PROXY=1

# DNS servers, comma-separated (development only, used by dns.setServers)
DNS_SERVERS=8.8.8.8,1.1.1.1
