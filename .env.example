# Server
PORT=3000
NODE_ENV=development

# MongoDB (Atlas replica set required for transactions)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/earnbridge?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ACCESS_TOKEN_COOKIE_NAME=eb_access_token
REFRESH_TOKEN_COOKIE_NAME=eb_refresh_token

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Arcjet (Security & Rate Limiting)
ARCJET_KEY=your-arcjet-key
ARCJET_ENV=development

# ayeT-Studios Offerwall
AYET_ADSLOT_ID=your-ayet-adslot-id
AYET_CALLBACK_SECRET=your-ayet-callback-hmac-secret
AYET_CALLBACK_IP_WHITELIST=1.2.3.4,5.6.7.8

# Rewards & Wallet
REWARD_SHARE_BPS=7000
CURRENCY_CODE=USD
MIN_WITHDRAWAL_AMOUNT=1000
MAX_WITHDRAWAL_AMOUNT=100000
WITHDRAWAL_HOLD_DAYS=7

# AI Chat (when implementing chat)
AI_PROVIDER=openai
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=gpt-4

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Sentry (before launch)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=info

# Trust proxy hops (Railway/Render = 1)
TRUST_PROXY=1

# DNS servers, comma-separated (development only, used by dns.setServers)
DNS_SERVERS=8.8.8.8,1.1.1.1
